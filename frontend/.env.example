# Copy to .env.local. Use the same Clerk instance as the backend.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Server-only destination for the same-origin /api rewrite (include /api).
API_URL=http://localhost:8080/api

# Optional: call an external API directly instead of the rewrite.
# Configure backend CLIENT/CORS for your Next.js origin when using this.
# NEXT_PUBLIC_API_URL=https://your-api.example.com/api
